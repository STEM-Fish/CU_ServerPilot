<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      CU ServerPilot - Casualties Unknown 服务器管理工具（BepInEx 5 插件）
      游戏: Unity 2022.3 Mono + BepInEx 5.4.23.4
      架构: 复用 STEM_Fish_MOD 验证过的工程配置
    -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CU_ServerPilot</AssemblyName>
    <Product>CU ServerPilot - Server Admin Tool</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CU_ServerPilot</RootNamespace>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unity 引擎模块（编译期引用，不随插件分发） -->
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.*" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- 游戏 BepInEx 自带 dll，HintPath 引用，Private=false 不复制 -->
    <Reference Include="BepInEx">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏主程序集（patch 游戏类用） -->
    <Reference Include="Assembly-CSharp">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- uGUI（Moodle 状态图标等 UnityEngine.UI 类型） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\CasualtiesUnknown_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      KrokMP（联机）：进服发道具等服务器端功能
      依赖 LiteNetLib（KrokMP 网络库），一并引用
    -->
    <Reference Include="KrokoshaCasualtiesMP">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\BepInEx\plugins\KrokMP\KrokoshaCasualtiesMP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LiteNetLib">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\BepInEx\plugins\KrokMP\LiteNetLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 翻译文件 JSON 解析（游戏自带 Newtonsoft.Json 13.x） -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>D:\Steam\steamapps\common\Casualties Unknown Demo\CasualtiesUnknown_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
